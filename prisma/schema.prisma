generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js tables (JWT session strategy => no Session / VerificationToken table)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String? // Google may not return a name -> nullable, UI falls back to email
  email         String    @unique
  emailVerified DateTime?
  image         String? // Google may not return a photo -> nullable, UI falls back to initials
  createdAt     DateTime  @default(now())

  accounts      Account[]
  favoriteMovie FavoriteMovie?
  facts         Fact[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Product tables
// ---------------------------------------------------------------------------

// One favorite movie per user. `userId @unique` enforces "one per user" in the
// database itself, so a double-submit of the onboarding form cannot create two.
model FavoriteMovie {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Append-only history of generated facts. We never update rows; the "current"
// fact is simply the newest row for (userId, movieTitle). This keeps writes
// simple and gives us an audit trail / fallback when OpenAI is down.
//
// `movieTitle` is a snapshot (not an FK to FavoriteMovie) so that old facts
// stay correct if the user's favorite movie ever changes.
//
// createdAt is timestamptz and is set with clock_timestamp() on insert (see
// src/lib/fact-store.ts) so the 60s window is measured on ONE clock: the DB's.
model Fact {
  id         String   @id @default(uuid())
  userId     String
  movieTitle String
  content    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Serves "latest fact for this user + movie" as a single index lookup.
  // Equality columns first, sort column last.
  @@index([userId, movieTitle, createdAt(sort: Desc)])
}
