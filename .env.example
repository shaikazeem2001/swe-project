# Postgres connection string (local Postgres, Neon, Supabase, ...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, "Web application")
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI — server-side only. NEVER prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=""
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL="gpt-4o-mini"
# Optional: only set to use an OpenAI-compatible provider instead of OpenAI (e.g. Groq)
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
